# ── Backend API ───────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000/api

# ── Environment ───────────────────────────────────────────────────────────────
REACT_APP_ENV=development

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# MUST match the Client ID in server/.env exactly.
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Authorized JavaScript origins: http://localhost:3000
REACT_APP_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── Edamam Recipe Search API (free developer plan) ───────────────────────────
# Register at https://developer.edamam.com/edamam-recipe-api
# Free tier: 10,000 calls/month
REACT_APP_EDAMAM_APP_ID=your_app_id_here
REACT_APP_EDAMAM_APP_KEY=your_app_key_here
